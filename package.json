{
  "name": "agent-build-harness",
  "version": "1.0.0",
  "description": "An unattended build harness for Claude Code: schedules sessions, meters what they spend, and stops when it should.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "bin": { "harness": "src/harness.mjs" },
  "files": ["src", "examples", "README.md", "LICENSE"],
  "scripts": {
    "test": "node test/harness.test.mjs",
    "test:stress": "node test/usage-gate.stress.mjs",
    "test:all": "node test/harness.test.mjs && node test/usage-gate.stress.mjs",
    "harness": "node src/harness.mjs"
  },
  "keywords": ["claude-code", "agent", "harness", "scheduler", "unattended", "cost-control", "llm"],
  "dependencies": {},
  "devDependencies": {}
}
